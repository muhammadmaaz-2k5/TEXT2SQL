# ============================================================================
# DataPilot AI — Environment Configuration
# ============================================================================

# --- Ports & URLs ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
API_PORT=4000
CORS_ORIGIN="http://localhost:3000"

# --- PostgreSQL / MongoDB (App Metadata Persistence) ---
# When Docker isn't running locally, DataPilot automatically falls back to
# an embedded persistent store + PGlite PostgreSQL instance in .data/
DATABASE_URL="postgresql://datapilot:datapilot_secret@localhost:5432/datapilot_meta?schema=public"
MONGODB_URI="mongodb+srv://<username>:<db_password>@cluster0.h6t8teg.mongodb.net/datapilot_meta"

# --- Managed PostgreSQL Provisioner Cluster ---
MANAGED_PG_HOST="localhost"
MANAGED_PG_PORT=5433
MANAGED_PG_ADMIN_USER="dp_provisioner"
MANAGED_PG_ADMIN_PASSWORD="dp_provisioner_secret"
MANAGED_PG_DEFAULT_DB="shop_analytics"

# --- Redis (Cache, Rate Limiting, BullMQ) ---
REDIS_URL="redis://localhost:6379"

# --- Security & Cryptography ---
# 32-byte hex key (64 hex chars) for AES-256-GCM encryption of DB credentials
CREDENTIAL_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
JWT_ACCESS_SECRET="dp_jwt_access_secret_change_in_production_2026"
JWT_REFRESH_SECRET="dp_jwt_refresh_secret_change_in_production_2026"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# --- AI (Groq Structured Outputs) ---
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_FALLBACK_MODEL="llama-3.3-70b-versatile"

# --- Query Execution Limits ---
QUERY_STATEMENT_TIMEOUT_MS=5000
QUERY_DEFAULT_ROW_LIMIT=500
QUERY_MAX_ROW_LIMIT=2000
QUERY_MAX_COST_CAP=100000

# --- Observability ---
OTEL_SERVICE_NAME="datapilot-api"
OTEL_EXPORTER_OTLP_ENDPOINT=""
LOG_LEVEL="info"

